{
	# Generated/overwritten by entrypoint before Caddy starts.
	# `tls internal` => Caddy's own self-signed cert (default).
	auto_https disable_redirects
	admin localhost:2019
}

https://:443 {
	import /etc/caddy/tls.conf

	encode zstd gzip

	# API, live event stream, uploaded assets, OpenAPI, and SCIM go to the backend
	@backend path /api/* /uploads/* /scim/*
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM} {
			flush_interval -1
		}
	}

	# Public share + invite links are SPA routes; everything else is the app shell
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# NOTE: no HSTS here on purpose — with the default self-signed cert, HSTS makes
	# browsers hard-refuse the connection (no click-through). Add HSTS at your edge
	# or here only once a real/trusted certificate is installed.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# AI Firewall (LLM gateway): OpenAI/Anthropic-compatible API over TLS.
# Only the public API is routed; /metrics and /readyz stay internal.
https://:8080 {
	import /etc/caddy/tls.conf

	@gateway path /v1/* /healthz
	handle @gateway {
		reverse_proxy {$GATEWAY_UPSTREAM} {
			flush_interval -1
			transport http {
				read_timeout 15m
			}
		}
	}
	handle {
		respond "Not found" 404
	}

	header {
		X-Content-Type-Options nosniff
		-Server
	}
}
