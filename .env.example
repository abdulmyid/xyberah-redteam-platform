# ---- Xyberah configuration -------------------------------------------------
# Copy to `.env` (the installer does this for you) and fill in as needed.

# First global-admin account, created once on first boot.
XYBERAH_ADMIN_USERNAME=admin@xyberah.local
# REQUIRED: set a strong password (min 10 chars). The installer generates one.
XYBERAH_ADMIN_PASSWORD=

# Port the HTTPS UI is published on (https://localhost:<port>)
XYBERAH_HTTPS_PORT=8443

# Grading model used to judge red-team outputs (needs the matching provider key).
XYBERAH_GRADER=openai:chat:gpt-4.1-mini

# ---- Model provider keys (add the ones your targets/graders use) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
